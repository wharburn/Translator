# API Keys
DEEPL_API_KEY=your_deepl_api_key_here

# Google Cloud Speech-to-Text credentials
# Optional - if not provided, mock responses will be used
GOOGLE_APPLICATION_CREDENTIALS=path_to_your_google_credentials.json
GOOGLE_PROJECT_ID=your_google_project_id

# Server configuration
PORT=5000
NODE_ENV=development

# Note: In production (on Render), you should set NODE_ENV=production
# and upload the Google credentials as a secret file
